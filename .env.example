# Copy to `.env` in this folder and fill in your values.
# Required for LLM answer generation (POST /api/answers/).
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o if unset.
OPENAI_ANSWER_MODEL=gpt-4o

# --- Database (restore user/auth routes to use these) ---
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/project_vl
# JWT_SECRET=change-me-to-a-long-random-string
