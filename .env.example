# Copy to `.env` in this folder and fill in your values.
# Required for LLM answer generation (POST /api/answers/).
OPENAI_API_KEY=sk-your-key-here

# Optional — defaults to gpt-4o if unset.
OPENAI_ANSWER_MODEL=gpt-4o
# Optional cheaper model for domain/subtype routing (defaults to OPENAI_ANSWER_MODEL or gpt-4o-mini)
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
# Optional vision model for pasted equation images (defaults to OPENAI_ANSWER_MODEL)
OPENAI_VISION_MODEL=gpt-4o

# --- Database & auth (required for /api/users/*) ---
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/project_vl
JWTKEY=change-me-to-a-long-random-string
# Session length in minutes (10080 = 7 days)
TOKEN_EXPIRE=10080

# --- Redis AI answer cache ---
# Bump AI_CACHE_VERSION when prompts or diagram rendering logic change (invalidates old cached answers).
AI_CACHE_VERSION=4
# Optional — default 86400 (24h). Use 300 during active development.
# AI_CACHE_TTL_SECONDS=86400
REDIS_URL=redis://localhost:6379/0

# --- Lemon Squeezy (test checkout). Create a store, then a product, and copy the ids. ---
# API key: Settings → API. Store id and variant id are on the product page.
# Webhook signing secret: Settings → Webhooks, pointed at /api/billing/webhook.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# Leave true until you are ready to charge real cards.
LEMONSQUEEZY_TEST_MODE=true

# --- Local asset / sticker uploads (testing; swap to R2/Supabase later) ---
# Relative paths resolve from the backend working directory (project_vl_be/).
# ASSET_UPLOAD_DIR=uploads
